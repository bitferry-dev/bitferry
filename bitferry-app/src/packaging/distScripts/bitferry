#!/bin/sh
# bitferry CLI launcher for the distro jar archive: the module path is the archive's
# lib dir (the packager adds their OpenJFX jars there for the GUI frontend). The
# backup engines travel via the RCLONE/RESTIC environment variables.

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -- )
if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD=java
fi
# The jansi console and the JNA dispatch natives extract into the archive's lib/tmp
# subdir (stable across the temp cleanings, immune to the noexec system temp; kept
# off the lib dir itself - the extraction cleanup sweeps would treat the jars as
# stale debris, jansi-*/jna-* matching their own module jars) and their System::load
# carries the native-access whitelist
exec "$JAVACMD" $JAVA_OPTS --enable-native-access=org.fusesource.jansi,com.sun.jna \
        "-Djansi.tmpdir=$DIR/../lib/tmp" "-Djna.tmpdir=$DIR/../lib/tmp" \
        --module-path "$DIR/../lib" -m io.bitferry.cli/io.bitferry.cli.Main "$@"

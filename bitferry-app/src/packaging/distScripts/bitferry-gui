#!/bin/sh
# bitferry-gui launcher for the distro jar archive: the module path is the archive's
# lib dir - the packager must place their OpenJFX jars there (or extend the module
# path via JAVA_OPTS).

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -- )
if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD=java
fi
# The JavaFX graphics, the jansi console and the JNA dispatch natives extract into
# (or load from) the archive's lib/tmp subdir (see the CLI launcher note) and their
# System::load carries the native-access whitelist
exec "$JAVACMD" $JAVA_OPTS --enable-native-access=javafx.graphics,org.fusesource.jansi,com.sun.jna \
        "-Djansi.tmpdir=$DIR/../lib/tmp" "-Djna.tmpdir=$DIR/../lib/tmp" \
        --module-path "$DIR/../lib" -m bitferry.gui/bitferry.gui.Main "$@"
